{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@sgt/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@sgt/validation": ["../../packages/validation/src/index.ts"],
      "@sgt/design-system": ["../../packages/design-system/src/index.ts"]
    }
  },
  "include": ["src"]
}
